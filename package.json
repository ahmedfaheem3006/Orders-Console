{
  "name": "orders-console",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "benchmark": "npm run benchmark -w server",
    "test": "npm run test --workspaces",
    "test:r2": "npm run test:r2 -w server",
    "test:auth": "npm run test:auth -w server",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w client"
  }
}

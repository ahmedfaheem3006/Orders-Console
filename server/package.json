{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "tsx --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:r2": "tsx --test --test-timeout=60000 test/createOrder.test.ts test/createOrder.multiprocess.test.ts",
    "test:auth": "tsx --test --test-timeout=60000 test/auth.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

# Template for .env (never commit .env).
# Easiest: run `npm run setup`, which copies this file to .env and fills in a random JWT_SECRET.

# Port the API listens on (127.0.0.1 only). The Vite dev server proxies /api here.
PORT=3001

# SQLite file on disk. Relative paths are resolved from the repository root.
DATABASE_PATH=server/data/orders.db

# Development aid: random 0..N ms delay on /api/orders, to reproduce
# out-of-order responses by hand. Keep 0 for normal use.
SIMULATED_LATENCY_MS=0

# Required. Secret used to sign and verify login tokens (HS256).
# At least 32 random characters; the server refuses to start without it.
# Generate one manually with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
